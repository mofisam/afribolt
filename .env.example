APP_NAME="AfriBolt Learning"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lagos
# true = policy pages show a draft banner + highlight terms to confirm. Set false once reviewed/approved.
LEGAL_DRAFT=true
# 32-byte key for encrypting meeting passcodes. Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=live_learning_platform
DB_USER=root
DB_PASS=

MAIL_FROM_ADDRESS=no-reply@afribolttechnologies.com
MAIL_FROM_NAME="AfriBolt Technologies"

# Payment gateway (Paystack is the example adapter - confirm with the client)
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Used by database/seed.php - change the password right after first login
SEED_ADMIN_EMAIL=admin@afribolttechnologies.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ---- Jobs board ----
# Claude API key for cleaning/categorising/recommending jobs. Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
JOBS_AI_MODEL=claude-haiku-5-5
JOBS_AI_REC_MODEL=claude-haiku-5-5
# Optional, for the Jooble source type (request a free key from Jooble)
JOOBLE_API_KEY=
